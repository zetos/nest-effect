{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "effect": "Effect-TS/effect"
  },
  "lsp": {
    "typescript": {
      "disabled": true
    },
    "effect-tsgo": {
      "command": [
        "node",
        "./node_modules/typescript/bin/tsc",
        "--lsp",
        "--stdio"
      ],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  }
}
